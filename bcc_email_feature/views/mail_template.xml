<odoo>
    <record id="mail_template_form_inherit_bcc" model="ir.ui.view">
        <field name="name">mail.template.form.inherit.bcc</field>
        <field name="model">mail.template</field>
        <field name="inherit_id" ref="mail.email_template_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reply_to']" position="before">
                <field name="bcc_partner_ids"
                       widget="many2many_tags_email"
                       options="{'no_create': True}"
                       placeholder="Partners who receive a separate copy..."/>
            </xpath>
        </field>
    </record>
</odoo>
