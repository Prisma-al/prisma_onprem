<odoo>
    <record id="mail_compose_message_form_inherit_bcc" model="ir.ui.view">
        <field name="name">mail.compose.message.form.inherit.bcc</field>
        <field name="model">mail.compose.message</field>
        <field name="inherit_id" ref="mail.email_compose_message_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='subject']" position="before">
                <field name="bcc_partner_ids"
                       widget="many2many_tags_email"
                       options="{'no_create': True}"
                       invisible="composition_mode != 'comment'"
                       groups="base.group_user"
                       placeholder="Partners who receive a separate copy..."/>
            </xpath>
        </field>
    </record>
</odoo>
