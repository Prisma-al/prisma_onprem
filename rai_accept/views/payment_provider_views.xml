<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="payment_provider_form_raiaccept" model="ir.ui.view">
            <field name="name">payment.provider.form.raiaccept</field>
            <field name="model">payment.provider</field>
            <field name="inherit_id" ref="payment.payment_provider_form"/>
            <field name="arch" type="xml">
                <group name="provider_config" position="inside">
                    <group invisible="code != 'rai_accept'" string="RaiAccept API Credentials">
                        <field name="raiaccept_username"/>
                        <field name="raiaccept_password" password="True"/>
                        <field name="raiaccept_client_id"/>
                        <field name="raiaccept_currency"/>
                        <a colspan="2" href="https://docs.raiaccept.com/" target="_blank">
                            RaiAccept Documentation
                        </a>
                    </group>
                </group>
            </field>
        </record>
    </data>
</odoo>
